@page "/"
@rendermode InteractiveServer

@inject IJSRuntime JSruntime

<div class="page">
    <div class="canvas-container">
        <canvas id="drawing-background"
                width="2080"
                height="1080"
                style="background-color: aliceblue"></canvas>
        </div>

    <div class="btn-toolbar" id="toolbar">
        <button class=" btn-primary" id="undo-draw">
            Undo
        </button>
        <button class=" btn-primary" id="redo-draw">
            Redo
        </button>
    </div>


    </div>

    

  

@code {   
    
    protected override async Task OnAfterRenderAsync (bool firstRender)
    {
        if (firstRender)
        {
            await JSruntime.InvokeVoidAsync("DragEvents");
           
        }
    }
   
}
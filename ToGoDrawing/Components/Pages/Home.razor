@page "/"
@using ToGoDrawing.Application
@rendermode InteractiveServer

@inject IJSRuntime JSruntime
@inject IRoomPersistence roomPersistence

    <div class="page">
        
        <div class="canvas-container">
        <canvas id="drawing-background"
                width="3440"
                height="1440"></canvas>
        </div>

    <div class="btn-toolbar" id="toolbar">
        <button class="btn" id="undo-draw" @onclick="() => UndoInvoke()">
            <img src="icons/undo.png" width="30" height="30" />
        </button>

        <button class="btn" id="redo-draw">
            <img src="icons/redo.png" width="30" height="30" @onclick="RedoInvoke"/>
        </button>

        <button class="btn" id="eraser-draw" @onclick="EraserInvoke" >
            <img src="icons/eraser-icon.png" width="30" height="30" />
        </button>

        <button class="btn" id="pencil-draw" @onclick="PencilInvoke">
            <img src="icons/pencil.png" width="30" height="30"/>
        </button>

        <button class="btn btn-primary" @onclick="ShowCreateRoom">Create Room</button>
        <button class="btn btn-secondary" @onclick="ShowJoinRoom">Join Room</button>
    </div> 

    @if (_show)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="custom-modal" @onclick:stopPropagation="true">
                <h3>@_title</h3>
            @if (_modalType != "share")
            {
                <input type="text" placeholder="@_placeholderUsername" @bind="_inputUsername" @onkeyup="HandleKeyUp" />
            }
                @if (_modalType == "join")
                {
                    <input type="text" placeholder="@_placeholderRoom" @bind="_inputRoomId" @onkeyup="HandleKeyUp" />
                }
                @if (_modalType == "share")
                {
                    <p>Share this code with your friends::</p>
                    <input type="text" readonly value="@_inputRoomId" />
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger" style="margin-top: 10px; padding: 5px; font-size: 0.9em;">
                        @_errorMessage
                    </div>
                }
                <div class="modal-actions">
                    <button class="modal-btn modal-btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="modal-btn modal-btn-primary" @onclick="HandleModalOk">OK</button>
                </div>
            </div>
        </div>
    }
    </div>

@code {
    private bool _show = false;
    private string _title = "";
    private string _placeholderUsername = "";
    private string _placeholderRoom = "";
    private string _inputUsername = "";
    private string _inputRoomId = "";
    private string _modalType = ""; // "create" o "join"
    private string _errorMessage = "";
    private string? _username = "";
    private string _roomId = "";
    private void ShowCreateRoom()
    {
        _errorMessage = "";
        _title = "Create Room";
        _placeholderUsername = "Enter your username";
        _inputUsername = "";
        _inputRoomId = "";
        _modalType = "create";
        _show = true;
    }

    private void ShowJoinRoom()
    {
        _errorMessage = "";
        _title = "Join Room";
        _placeholderUsername = "Enter your username";
        _placeholderRoom = "Enter the room code";
        _inputRoomId = "";
        _modalType = "join";
        _show = true;
    }

    private void CloseModal()
    {
        _errorMessage = "";
        _show = false;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleModalOk();
        }
        else if (e.Key == "Escape")
        {
            CloseModal();
        }
    }

    private async Task HandleModalOk()
    {
        _errorMessage = "";
        if (_modalType == "share")
        {
            _show = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_inputUsername))
        {
            _errorMessage = "Username is required";
            return;
        }

        if (_modalType == "create")
        {
            await JSruntime.InvokeVoidAsync("ReceiveUsername", _inputUsername);
            await JSruntime.InvokeVoidAsync("CreateRoom");
            await ReceiveRoomId();
            _title = "Room Created";
            _modalType = "share";
            Console.WriteLine($"Room created for user: {_inputUsername}, Room ID: {_inputRoomId}");
            StateHasChanged();
            return;
        }
        else if (_modalType == "join")
        {
            if (string.IsNullOrWhiteSpace(_inputRoomId))
            {
                _errorMessage = "Room code is required";
                return;
            }

            if (roomPersistence.GetRoomDictionary(_inputRoomId) != null)
            {
                await JSruntime.InvokeVoidAsync("JoinRoom", _inputRoomId);
                await JSruntime.InvokeVoidAsync("ReceiveUsername", _inputUsername);
                Console.WriteLine($"Joining room: {_inputRoomId} with user: {_inputUsername}");
            }
            else
            {
                _errorMessage = "The room does not exist";
                return;
            }
        }
        
        _show = false;
        StateHasChanged();
    }

    private async Task ReceiveRoomId()
    {
        _inputRoomId = await JSruntime.InvokeAsync<string>("SendRoomId");
    }
    
    private async Task PencilInvoke()
    {
        await JSruntime.InvokeVoidAsync("SetModePencil");
    }
    
    private async Task EraserInvoke()
    {
      await JSruntime.InvokeVoidAsync("SetModeEraser");
    }
    
    private async Task UndoInvoke()
    {
        await JSruntime.InvokeVoidAsync("UndoDrawing");
    }

    private async Task RedoInvoke()
    {
        await JSruntime.InvokeVoidAsync("RedoDrawing");
    }
    
    
    protected override async Task OnAfterRenderAsync (bool firstRender)
    {
        if (firstRender)
        {
          await JSruntime.InvokeVoidAsync("InitCanvas");
        }
    }
}